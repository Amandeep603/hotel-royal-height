# Client Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
NEXT_PUBLIC_HOTEL_NAME="Hotel Royal Heights"
NEXT_PUBLIC_HOTEL_LOCATION="Rishikesh, Uttarakhand, India"

# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/hotel-royal-heights
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_key_change_in_production_987654321

# Payment Gateway (Razorpay)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Email Service (Nodemailer)
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reservations@hotelroyalheights.com
SMTP_PASS=app_password_placeholder
ADMIN_EMAIL=reservations@hotelroyalheights.com
